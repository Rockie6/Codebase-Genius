# Codebase Genius configuration
# Copy this file to .env and fill in whatever you need.

# Default repository when none is given on the command line
CODEBASE_GENIUS_REPO_URL=https://github.com/pallets/flask

# Set to false for a quick run that skips the deep code analysis
CODEBASE_GENIUS_ANALYZE_DEEP=true

# LLM extras (Gemini)
# Turn on AI-powered README summaries. Accepts: 1, true, yes, on
USE_LLM=false

# Your Google Gemini API key (get one at https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-api-key-here

# Which Gemini model to use (optional)
GEMINI_MODEL=gemini-1.5-flash
